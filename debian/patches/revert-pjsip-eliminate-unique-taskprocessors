-
-struct ast_taskprocessor *ast_sip_get_distributor_serializer_dialog(pjsip_dialog *dlg)
-{
-	int hash;
-	struct ast_taskprocessor *serializer;
-
-	if (!dlg) {
-		return NULL;
-	}
-
-	/* Compute the hash from the SIP message call-id and tag */
